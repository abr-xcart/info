# .bash_profile

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
  . ~/.bashrc
fi

# User specific environment and startup programs

PATH=/usr/local/bin:$PATH:$HOME/bin

export PATH

source /etc/profile.d/bash_completion.sh
source <(kubectl completion bash)
source <(helm completion bash)

[ "$GIT_AUTHOR_NAME" = "Yuriy Abramov" ] && /usr/bin/screen -S pull-bin -d -m bash -c "( cd /opt/planeta/bin && git pull ) || sleep infinity"

[ -e /opt/planeta/bin/cluster-stuff.sh ] && /opt/planeta/bin/cluster-stuff.sh
